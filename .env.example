# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# NASA_API_KEY: Required for fetching real-time hotspot data from NASA FIRMS.
# Get a MAP_KEY from https://firms.modaps.eosdis.nasa.gov/api/
NASA_API_KEY="MY_NASA_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# TELEGRAM BOT: Required for automated background alerts to Telegram
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"
# TELEGRAM_CHAT_ID: ID grup untuk peringatan darurat karhutla (diawali tanda minus -100...)
TELEGRAM_CHAT_ID="MY_TELEGRAM_CHAT_ID"

# TELEGRAM USER PRIBADI (dimasukkan via Secret untuk Laporan Detak Jantung / Heartbeat):
# Masukkan User ID Telegram akun pribadi Anda (angka positif, bukan grup)
TELEGRAM_USER_CHAT_ID="1234567890"

# FONNTE_TOKEN: Token for WhatsApp notifications using Fonnte API
FONNTE_TOKEN="MY_FONNTE_TOKEN"

# NOMOR TARGET WHATSAPP (dimasukkan via Secret):
# Nomor HP penerima notifikasi otomatis WhatsApp (contoh: 081234567890 atau 6281234567890)
WHATSAPP_TARGET_PHONE="081234567890"
FONNTE_TARGET_PHONE="081234567890"

# AUTO_NOTIFY_INTERVAL_MINUTES: Interval for background check in minutes (default: 15)
AUTO_NOTIFY_INTERVAL_MINUTES="15"
